pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build React App') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                rm -rf /var/www/html/*
                cp -r build/* /var/www/html/
                '''
            }
        }
       stage('Deploy to Apache') {
    steps {
        sh 'sudo rm -rf /var/www/html/*'
        sh 'sudo cp -r build/* /var/www/html/'
        sh 'sudo chown -R www-data:www-data /var/www/html'
    }
}
}
}
